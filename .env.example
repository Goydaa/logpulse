# Скопируйте в .env: cp .env.example .env
# Реальные пароли и токены в репозиторий не коммитим.

# Подключение к Redis (в Compose Redis доступен по имени сервиса "redis")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Порт API на хосте (публикуется только на 127.0.0.1)
API_PORT=8000

# Порог медленного запроса, мс
SLOW_THRESHOLD_MS=500

# Имя consumer'а worker внутри группы logpulse-workers
WORKER_CONSUMER=worker-1
WORKER_BLOCK_MS=2000
