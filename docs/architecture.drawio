<mxfile host="app.diagrams.net"><diagram name="LogPulse architecture" id="logpulse-arch"><mxGraphModel dx="1300" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dock" value="Docker Compose (сеть logpulse_default). Порт API опубликован только на 127.0.0.1:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#6c8ebf;verticalAlign=top;arcSize=4;fontSize=12;dashed=1;align=left;spacingLeft=8;fontStyle=1;fontColor=#3b5c8a;" vertex="1" parent="1"><mxGeometry x="190" y="20" width="1090" height="780" as="geometry"/></mxCell><mxCell id="client" value="Клиент&lt;br&gt;curl, Swagger,&lt;br&gt;load_sample.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;verticalAlign=middle;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="330" width="120" height="90" as="geometry"/></mxCell><mxCell id="api" value="api (контейнер)&lt;br&gt;&lt;br&gt;FastAPI + APIRouter&lt;br&gt;Pydantic-схемы&lt;br&gt;parser.py (regex)&lt;br&gt;&lt;br&gt;Маршруты:&lt;br&gt;GET /health&lt;br&gt;POST /ingest&lt;br&gt;GET /stats&lt;br&gt;GET /events&lt;br&gt;&lt;br&gt;ENV: REDIS_HOST=redis&lt;br&gt;REDIS_PORT=6379&lt;br&gt;SLOW_THRESHOLD_MS=500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="110" width="230" height="380" as="geometry"/></mxCell><mxCell id="redis" value="redis (контейнер, redis:7-alpine)&lt;br&gt;healthcheck: redis-cli ping&lt;br&gt;appendonly yes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="50" width="340" height="650" as="geometry"/></mxCell><mxCell id="stream" value="logpulse:events&lt;br&gt;Stream, группа logpulse-workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=middle;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="280" height="90" as="geometry"/></mxCell><mxCell id="hash" value="logpulse:stats:level&lt;br&gt;logpulse:stats:service&lt;br&gt;logpulse:stats:status&lt;br&gt;(Hash) + stats:total, stats:queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=middle;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="290" width="280" height="120" as="geometry"/></mxCell><mxCell id="zset" value="logpulse:slow&lt;br&gt;Sorted Set, score = duration_ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=middle;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="440" width="280" height="70" as="geometry"/></mxCell><mxCell id="set" value="logpulse:processed&lt;br&gt;Set из rid (идемпотентность)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=middle;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="540" width="280" height="70" as="geometry"/></mxCell><mxCell id="worker" value="worker (контейнер)&lt;br&gt;python -m app.worker&lt;br&gt;&lt;br&gt;XREADGROUP (consumer worker-1)&lt;br&gt;идемпотентный apply_event&lt;br&gt;XACK после обновления&lt;br&gt;&lt;br&gt;ENV: REDIS_HOST=redis&lt;br&gt;WORKER_CONSUMER=worker-1&lt;br&gt;WORKER_BLOCK_MS=2000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="310" height="330" as="geometry"/></mxCell><mxCell id="volume" value="named volume redis-data (/data, AOF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="735" width="250" height="50" as="geometry"/></mxCell><mxCell id="recovery" value="Восстановление после перезапуска&lt;br&gt;1. docker compose restart redis&lt;br&gt;2. healthcheck: redis-cli ping&lt;br&gt;3. API отвечает 503, пока нет связи&lt;br&gt;4. API и worker переподключаются сами&lt;br&gt;5. данные читаются из volume (AOF)&lt;br&gt;6. worker дочитывает pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;arcSize=4;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="310" height="220" as="geometry"/></mxCell><mxCell id="e_client" value="POST /ingest&lt;br&gt;GET /stats" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="375" as="sourcePoint"/><mxPoint x="235" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_xadd" value="XADD&lt;br&gt;события" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="190" as="sourcePoint"/><mxPoint x="550" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_stats_read" value="HGETALL,&lt;br&gt;ZREVRANGE" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="380" as="sourcePoint"/><mxPoint x="550" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_xread" value="XREADGROUP" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="175" as="sourcePoint"/><mxPoint x="940" y="250" as="targetPoint"/><Array as="points"><mxPoint x="885" y="175"/><mxPoint x="885" y="250"/></Array></mxGeometry></mxCell><mxCell id="e_h" value="HINCRBY" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="400" as="sourcePoint"/><mxPoint x="830" y="340" as="targetPoint"/><Array as="points"><mxPoint x="905" y="400"/><mxPoint x="905" y="340"/></Array></mxGeometry></mxCell><mxCell id="e_z" value="ZADD" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="440" as="sourcePoint"/><mxPoint x="830" y="475" as="targetPoint"/><Array as="points"><mxPoint x="885" y="440"/><mxPoint x="885" y="475"/></Array></mxGeometry></mxCell><mxCell id="e_s" value="SADD" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="480" as="sourcePoint"/><mxPoint x="830" y="575" as="targetPoint"/><Array as="points"><mxPoint x="865" y="480"/><mxPoint x="865" y="575"/></Array></mxGeometry></mxCell><mxCell id="e_vol" value="AOF" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#8a1c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="700" as="sourcePoint"/><mxPoint x="690" y="735" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>